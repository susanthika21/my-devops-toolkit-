pipeline {
    agent any
    stages {
        stage('Build Docker Image') {
            steps {
                // Build from the folder inside the workspace
                sh 'docker build -t flask-app:latest ./jenkins-docker-demo'
            }
        }
        stage('Run Container') {
            steps {
                sh 'docker rm -f flask-container || true'
                sh 'docker run -d -p 5001:5000 --name flask-container flask-app:latest'
                
            }
        }
    }
}
